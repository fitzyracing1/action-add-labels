{
  "name": "action-add-labels",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Add labels to an issue or a pull request (360 Bench fork on Node 24)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format-check": "prettier --check \"src/**/*.ts\"",
    "test": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzyracing1/action-add-labels.git"
  },
  "keywords": [
    "actions",
    "github",
    "labels"
  ],
  "author": "The Actions Ecosystem Authors",
  "contributors": [
    "Joshua Almeida <fitzyracing1@gmail.com> (360 Bench fork)"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
